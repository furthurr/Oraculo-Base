# Entorno local — copia este archivo a `.env` y rellena los valores.
# NUNCA subas `.env` al repositorio.

# Token de Telegram siempre obligatorio; cada proveedor exige su credencial.
TELEGRAM_BOT_TOKEN=

# mimo (default) | deepseek | gpt (OAuth Codex no oficial; login local previo)
AI_PROVIDER=mimo

# --- Xiaomi MiMo (solo si AI_PROVIDER=mimo) ---
# Dos modos (credenciales NO intercambiables):
# - Pago por uso: API key `sk-…` de https://platform.xiaomimimo.com/#/console/api-keys
#   Base URL por defecto: https://api.xiaomimimo.com/v1
# - Token Plan: API key `tp-…` (individual) o `ttp-…` (equipo). MIMO_BASE_URL es
#   OBLIGATORIA con la URL de TU clúster (consola Token Plan > plan-manage);
#   p. ej. https://token-plan-sgp.xiaomimimo.com/v1
MIMO_API_KEY=
# MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
# Modelos: mimo-v2.6-flash (default), mimo-v2.6-pro, mimo-v2.6-pro-ultraspeed
# (también se aceptan con el prefijo xiaomi/)
# MIMO_MODEL=xiaomi/mimo-v2.6-flash
# MIMO_TIMEOUT_S=30
# MIMO_MAX_TOKENS=1024

# --- DeepSeek (solo si AI_PROVIDER=deepseek) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_S=30
DEEPSEEK_MAX_TOKENS=1024
# Thinking mode de DeepSeek: enabled | disabled (disabled).
# Con thinking activado el bot razona antes de responder (más lento y costoso).
DEEPSEEK_THINKING=disabled
# Esfuerzo de razonamiento: low | high | max (low). Solo aplica con thinking enabled.
DEEPSEEK_REASONING_EFFORT=low

# --- GPT (solo si AI_PROVIDER=gpt) ---
# Para GPT: ruta absoluta FUERA del repo, por defecto ~/.local/share/oraculo/oauth.json
# GPT_CREDENTIAL_PATH=/ruta/fuera/del/repo/oauth.json
# GPT_MODEL=gpt-6-luna
# GPT_TIMEOUT_S=30

# --- Transcripción de audio local (independiente de AI_PROVIDER) ---
# faster-whisper ejecuta STT localmente y no requiere clave de transcripción.
# En el primer uso se descarga el modelo base (~150 MB) si no está en la caché.
# El texto transcrito/caption se envía al proveedor conversacional configurado.

# Instrucción de sistema para la IA (idioma y tono de las respuestas).
# Si se deja vacío se usa la instrucción por defecto (responder en español).
# Se aplica a todos los proveedores.
DEEPSEEK_SYSTEM_PROMPT=

# Listas separadas por comas. Ejemplo: 11111111,22222222
ALLOWED_USER_IDS=
# IDs de grupos (negativos). Ejemplo: -1001234567890
ALLOWED_CHAT_IDS=

# Máximo de updates de Telegram procesados a la vez (entero > 0; default 1).
# 1 conserva el procesamiento secuencial. Usa 2 o más para habilitar concurrencia
# entre sesiones distintas; los mensajes de una misma sesión siguen en orden.
MAX_CONCURRENT_UPDATES=1

# Workspace documental: disabled (predeterminado) | enabled.
# La carpeta debe estar en <raíz-del-proyecto>/workspace con permisos 0700.
# Se ignora en Git mediante /workspace/ en .gitignore.
WORKSPACE_ENABLED=disabled
# Opcional: debe coincidir exactamente con <raíz-del-proyecto>/workspace.
# WORKSPACE_DIR=/ruta/absoluta/al/proyecto/workspace
# IDs de grupos (negativos) con workspace habilitado, separados por coma.
# Cada ID debe estar también en ALLOWED_CHAT_IDS. Cualquier participante
# humano del grupo podrá usar el workspace compartido de ese grupo.
WORKSPACE_GROUP_IDS=

# Modo Pi: integración con el agente Pi mediante RPC.
# disabled (predeterminado) | enabled
PI_ENABLED=disabled
# Carpeta de proyectos de Pi (relativa a la raíz del proyecto o absoluta).
# Cada subcarpeta de primer nivel es un proyecto: al enviar /agent, el bot las
# lista numeradas y Pi trabaja en la que elijas (o en una nueva que crees).
# PI_WORKSPACE_DIR=workspace/pi
# Usuarios "root" del modo Pi: IDs de Telegram separados por comas.
# Solo estos usuarios ven una opción extra al enviar /agent para trabajar en la
# RAÍZ del proyecto Oraculo (no solo en workspace/pi). Cada ID debe estar
# también en ALLOWED_USER_IDS. Se ignora si PI_ENABLED=disabled.
# RIESGO: en la raíz, Pi puede leer .env (tokens), modificar el código de
# Oraculo y ejecutar comandos sin sandbox. Concede acceso solo a IDs de total
# confianza. Ejemplo: 11111111,22222222
PI_ROOT_USER_IDS=
# Segundos mínimos entre ediciones del mensaje mientras Pi escribe (streaming).
# Los fragmentos se agrupan y el texto final siempre se muestra al instante.
# Telegram limita las ediciones a ~1 por segundo por chat: valores menores
# pueden provocar esperas por flood control. Vacío = 1.0. Debe ser > 0.
# PI_STREAM_EDIT_INTERVAL_S=1.0

# Frases de rechazo separadas por "|".
# Si se deja vacío se usa la lista por defecto del proyecto.
REJECTION_PHRASES=

# Frases para los demás mensajes automáticos (separadas por "|").
# Si se dejan vacías se usa la lista por defecto del proyecto.
# Mensajes que no son de texto (fotos, stickers, audio, etc.):
ONLY_TEXT_PHRASES=
# Solo la mención al bot, sin pregunta:
EMPTY_MENTION_PHRASES=
# Memoria conversacional (sesiones en memoria; se pierden al reiniciar).
# Turnos por tramo antes de resumir: 0 desactiva la memoria; máximo 40 (40).
SESSION_MAX_TURNS=40
# Minutos de inactividad antes de cerrar la conversación; 0 = nunca (240).
SESSION_IDLE_MINUTES=240

# Frases de confirmación al reiniciar la sesión con /new o /reset (separadas por "|").
# Si se deja vacío se usa la lista por defecto del proyecto.
NEW_SESSION_PHRASES=

# Skills declarativas locales (se cargan una sola vez al arrancar).
# Apagador global: enabled | disabled (enabled). Con disabled no se lee SKILLS_DIR.
SKILLS_ENABLED=enabled
# Directorio que contiene `<slug>/SKILL.md` (skills).
SKILLS_DIR=skills
# Selección autónoma por el proveedor seleccionado: enabled | disabled (enabled).
# Aunque esté disabled, el usuario todavía puede invocar una skill con `$slug`.
SKILLS_AUTOLOAD=enabled
# Máximo de caracteres del cuerpo de cada SKILL.md: 1000-100000 (20000).
SKILL_MAX_CHARS=20000
# Presupuesto del catálogo compacto enviado al modelo: 1000-50000 (8000).
SKILLS_CATALOG_MAX_CHARS=8000
# Presupuesto total de contexto de skills: 1000-200000 y >= SKILL_MAX_CHARS (40000).
SKILLS_MAX_CONTEXT_CHARS=40000
# Skills explícitas distintas permitidas por turno: 1-8 (3).
SKILLS_MAX_PER_TURN=3
# Máximo de rondas de carga autónoma por turno: 1-5 (3).
SKILLS_MAX_ROUNDS=3
# Respuesta local cuando una invocación explícita excede los límites.
# Si no se define, se usa la frase segura por defecto del proyecto.
# SKILLS_LIMIT_PHRASE=Reduce la cantidad de skills e intenta de nuevo.
